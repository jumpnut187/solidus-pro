# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Build/dist
build/
dist/
*.egg-info/

# Numba cache
*.nbc
*.nbi

# Logs
logs/
*.log

# Temporary files
*.tmp
temp/
.temp/

# OS files
.DS_Store
Thumbs.db

# Data files (optional - uncomment if you don't want to track)
# data/*.csv
# models/*.joblib

# Docs
# docs/ was ignored, which hid the project's own documentation from every
# clone. Ignore only the large generated artifacts inside it.
docs/*.pdf
docs/*.mov

# Memory mapped files
*.mmap

# Web app run database and backups. Holds uploaded part names and run
# history from real jobs -- local state, never source.
web/simulations.db
web/*.db
data/legacy_web_backup/

# User-uploaded CAD for the web app. 1.2 GB / 668 files at last count, and
# regenerated per session -- never source.
web/static/uploads/

# Trained deep-model artifacts (~256 MB). Build outputs, not source; git
# stores large binaries poorly and every clone would pay the cost forever.
models/deep_model/
